VITE_API_BASE_URL=http://127.0.0.1:3000

VITE_API_PREFIX=/api/admin

# 与后端 TENANCY_DRIVER=database 对齐时开启；登录显示租户码并自动带 X-Tenant-ID
# VITE_TENANCY_ENABLED=true
# VITE_TENANCY_DRIVER=database
# VITE_TENANCY_HEADER=X-Tenant-ID
# Match backend TENANCY_BASE_DOMAIN so acme.example.com auto-binds without ?tenant_code=
# VITE_TENANCY_BASE_DOMAIN=example.com

# Optional: platform login back to tenant admin absolute URL (hosted demo)
# VITE_TENANT_DEMO_LOGIN_URL=https://acme.xuancheng888.top/login
