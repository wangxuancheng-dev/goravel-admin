## EN: Production env template — copy to server .env; never commit real secrets
## ZH: 生产环境变量模板（复制为服务器上的 .env，勿提交真实密钥）
## EN: See website/docs/deploy/production.md and website/docs/guide/opensource.md
## ZH: 对照：website/docs/deploy/production.md、website/docs/guide/opensource.md
#
# cp .env.production.example .env
# go run . artisan key:generate
## EN: Then fill JWT_SECRET, database, and Redis
## ZH: 再填写 JWT_SECRET、数据库与 Redis

APP_NAME=Goravel
APP_ENV=production
APP_DEBUG=false
APP_URL=https://admin.example.com
APP_HOST=0.0.0.0
APP_PORT=3000
APP_KEY=
# APP_VERSION=1.0.0
## EN: Enable HSTS (seconds) behind an HTTPS terminator
## ZH: HTTPS 终结后开启 HSTS（秒）
SECURITY_HSTS_MAX_AGE=31536000
JWT_SECRET=
JWT_TTL=600

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goravel
DB_USERNAME=
DB_PASSWORD=

## EN: Production must use Redis (rate limits / locks / cache across instances)
## ZH: 生产必须用 Redis（多实例限流/锁/缓存一致）
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_CONCURRENT=2
QUEUE_TRIES=5
## EN: API node (HTTP only): uncomment next line
## ZH: API 节点（只 HTTP）：取消下一行注释
# APP_DISABLED_RUNNERS=queue-*
## EN: Worker node: leave APP_DISABLED_RUNNERS empty and QUEUE_CONNECTION=redis. See production.md section 4.1
## ZH: Worker 节点：保持 APP_DISABLED_RUNNERS 为空，并确保 QUEUE_CONNECTION=redis。详见 website/docs/deploy/production.md §4.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=
## EN: TLS managed Redis (e.g. AWS ElastiCache Serverless): REDIS_TLS=true
## ZH: 托管 Redis TLS（如 AWS ElastiCache Serverless）：REDIS_TLS=true
# REDIS_TLS=false
# REDIS_TLS_SERVER_NAME=
# REDIS_CLUSTER=false

## EN: WebSocket cross-API push via Redis Pub/Sub (auto with ./main)
## ZH: WebSocket 跨 API 推送（Redis Pub/Sub，随 ./main 自动启动）
# WEBSOCKET_REDIS_BRIDGE=true
# WEBSOCKET_REDIS_CHANNEL=goravel:ws:notifications
# WEBSOCKET_REDIS_PRESENCE_KEY=goravel:ws:presence


## EN: Disable debug surfaces in production
## ZH: 生产关闭调试面
SWAGGER_ENABLED=false
APP_ENABLE_DEV_TOOL=false
# PPROF_ENABLED=false

## EN: Demo business modules — disable if unused
## ZH: 示例业务：不需要则关闭
MODULE_ORDERS_ENABLED=true
MODULE_SCHEDULE_DEMO_ENABLED=true
MODULE_PAYMENTS_ENABLED=false
## EN: Production: explicit RegisterPaymentGateway type allowlist (avoid empty/*)
## ZH: 生产：显式支付网关类型白名单（避免空/*）
# PAYMENT_GATEWAYS_ENABLED=wechat,alipay

## EN: CORS: empty/* => any Origin (demo OK). Else allowlist + auto *.{TENANCY_BASE_DOMAIN}.
## ZH: CORS：空/* => 任意 Origin（演示可用）。否则白名单 + 自动 *.{TENANCY_BASE_DOMAIN}。
## EN: Vanity + split API: prefer same-Host /api; do not list every merchant domain.
## ZH: 独立域名 + 前后端分离：优先同 Host /api；勿罗列每个商户域。
# CORS_ALLOWED_ORIGINS=https://admin.example.com
# CORS_ALLOWED_ORIGINS=
# DOMAINS_ADMIN=admin.example.com
## EN: Multi-tenant + split Pages/API: Origin guard (no-op if TENANCY_DRIVER=off)
## ZH: 多租户 + 前后端分离：Origin 校验（TENANCY_DRIVER=off 时无效）
# ADMIN_ORIGIN_GUARD=true
# TENANCY_BASE_DOMAIN=example.com
## EN: Static CNAME target for edge vanity; see tenancy.md
## ZH: 边缘独立域名的静态 CNAME 目标；见 tenancy.md
# TENANCY_DOMAIN_TARGET=tenants.example.com

## EN: DB-per-tenant (public): enable after DNS/ops ready. See website/docs/advanced/tenancy.md
## ZH: 多租户一户一库（公网）：确认 DNS/运维后再开，见 website/docs/advanced/tenancy.md
## EN: Default pool ~<50 active; for 1k+ tighten OPEN + REGISTERED_MAX + split hosts — see docs scale section
## ZH: 默认池适合约 <50 活跃；千级务必收紧 OPEN + REGISTERED_MAX + 分 host，见文档「规模与推荐配置」
# TENANCY_DRIVER=database
# TENANCY_RESOLVER=subdomain
# TENANCY_ALLOW_HEADER_FALLBACK=false
# TENANCY_ALLOW_PLATFORM_DB_CREDENTIALS=false
# TENANCY_POOL_MAX_IDLE_CONNS=1
# TENANCY_POOL_MAX_OPEN_CONNS=2
# TENANCY_REGISTERED_IDLE_TTL=900
# TENANCY_REGISTERED_MAX=400
# TENANCY_SCOPE_AUTO_BATCH_AT=200
# TENANCY_SCOPE_AUTO_BATCH=100
# TENANCY_FLEX_SCHEDULE_TICK_LIMIT=2000
# TENANCY_FLEX_SCHEDULE_QUEUE=schedule
## EN: CLI migrate-all/seed-all only; same host 2-5; many tenants.host 20-50; max 100
## ZH: 仅 CLI migrate-all/seed-all；同机 2-5；多 host 20-50；最大 100
# TENANCY_MIGRATE_CONCURRENCY=2
## EN: Backup fleet parallel dumps (1..50)
## ZH: 备份车队并行 dump（1..50）
# TENANCY_BACKUP_CONCURRENCY=2
## EN: full=every tenant/day; rotate=BATCH/day
## ZH: full=每天全部租户；rotate=每天 BATCH 个
# TENANT_BACKUP_SCHEDULE_MODE=full
## EN: Collection queue; lower to 1-2 during migrate-all (tenant DB IO)
## ZH: 采集队列；migrate-all 期间降到 1-2（争夺租户库 IO）
# QUEUE_SCHEDULE_CONCURRENT=10
## EN: UI tenant_ops; keep 1; do not stack with CLI migrate-all; restart Workers after change
## ZH: UI 租户运维；保持 1；勿与 CLI migrate-all 叠跑；改后重启 Worker
# QUEUE_LONG_RUNNING_CONCURRENT=1
## EN: See website/docs/advanced/tenancy.md (UI batch + restart table)
## ZH: 见 website/docs/advanced/tenancy.md（UI 批量与重启说明）
# TENANT_BACKUP_SCHEDULE_ENABLED=false
# TENANT_BACKUP_SCHEDULE_BATCH=100
# TENANCY_SUBDOMAIN_RESERVED=www,api,admin,platform,static,assets
## EN: Worker hosts must NOT set APP_DISABLED_RUNNERS=queue-* (need queue-default / long-running / schedule)
## ZH: Worker 机勿设置 APP_DISABLED_RUNNERS=queue-*（需 queue-default / long-running / schedule）
## EN: API hosts: APP_DISABLED_RUNNERS=queue-*
## ZH: API 机：APP_DISABLED_RUNNERS=queue-*
# PLATFORM_ADMIN_USERNAME=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=Platform Admin

## EN: Health: GET /health liveness; GET /ready dependency probe (usually no change needed)
## ZH: 健康检查（通常无需改）：GET /health 存活；GET /ready 依赖探测
# READY_ALERT_WEBHOOK_URL=
# QUEUE_ALERT_WEBHOOK_URL=
# QUEUE_ALERT_BACKLOG_THRESHOLD=100


# ---------------------------------------------------------------------------
## EN: Prometheus metrics scrape (GET /metrics)
## ZH: Prometheus 指标抓取（GET /metrics）
# ---------------------------------------------------------------------------
# METRICS_ENABLED=false
# METRICS_TOKEN=

# ---------------------------------------------------------------------------
## EN: OIDC / Enterprise SSO (admin login)
## ZH: OIDC / 企业 SSO（后台登录）
# ---------------------------------------------------------------------------
# OIDC_ENABLED=false
# OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://api.example.com/api/admin/auth/oidc/callback
# OIDC_FRONTEND_REDIRECT=https://admin.example.com/login/oidc-callback
# OIDC_SCOPES=openid profile email
# OIDC_BUTTON_LABEL=Enterprise SSO
# OIDC_AUTO_PROVISION=false

# ---------------------------------------------------------------------------
## EN: Audit log retention (days) for scheduled operation/login log archives
## ZH: 审计日志保留天数（定时归档操作/登录日志）
## EN: Optional SIEM webhook: JSON POST for login + operation audit events
## ZH: 可选 SIEM Webhook：登录与操作审计事件 JSON POST
# ---------------------------------------------------------------------------
# AUDIT_LOG_RETENTION_DAYS=30
# AUDIT_WEBHOOK_URL=
