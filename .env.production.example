# 生产环境变量模板（复制为服务器上的 .env，勿提交真实密钥）
# 对照：website/docs/deploy/production.md、website/docs/guide/opensource.md
#
# cp .env.production.example .env
# go run . artisan key:generate
# 再填写 JWT_SECRET、数据库与 Redis

APP_NAME=Goravel
APP_ENV=production
APP_DEBUG=false
APP_URL=https://admin.example.com
APP_HOST=0.0.0.0
APP_PORT=3000
APP_KEY=
# APP_VERSION=1.0.0
# HTTPS terminator 后开启 HSTS（秒）
SECURITY_HSTS_MAX_AGE=31536000
JWT_SECRET=
JWT_TTL=600

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goravel
DB_USERNAME=
DB_PASSWORD=

# 生产必须用 Redis（多实例限流/锁/缓存一致）
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_CONCURRENT=2
QUEUE_TRIES=5
# API 节点（只 HTTP）：取消下一行注释
# APP_DISABLED_RUNNERS=queue-*
# Worker 节点：保持 APP_DISABLED_RUNNERS 为空，并确保 QUEUE_CONNECTION=redis
# 详见 website/docs/deploy/production.md §4.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

SESSION_DRIVER=file
SESSION_LIFETIME=120

# 生产关闭调试面
SWAGGER_ENABLED=false
APP_ENABLE_DEV_TOOL=false
# PPROF_ENABLED=false

# 示例业务：不需要则关闭
MODULE_ORDERS_ENABLED=true
MODULE_PAYMENTS_ENABLED=false
# Production: explicit allowlist of RegisterPaymentGateway types (avoid empty/*).
# PAYMENT_GATEWAYS_ENABLED=wechat,alipay

# CORS: empty/* => any Origin (demo OK). Else allowlist + auto *.{TENANCY_BASE_DOMAIN}.
# Vanity + split API: prefer same-Host /api; do not list every merchant domain.
# CORS_ALLOWED_ORIGINS=https://admin.example.com
# CORS_ALLOWED_ORIGINS=
# DOMAINS_ADMIN=admin.example.com
# TENANCY_BASE_DOMAIN=example.com
# TENANCY_DOMAIN_TARGET=tenants.example.com  # static CNAME target for edge vanity; see tenancy.md

# 多租户一户一库（公网）：确认 DNS/运维后再开，见 website/docs/advanced/tenancy.md
# TENANCY_DRIVER=database
# TENANCY_RESOLVER=subdomain
# TENANCY_ALLOW_HEADER_FALLBACK=false
# TENANCY_ALLOW_PLATFORM_DB_CREDENTIALS=false
# TENANCY_POOL_MAX_IDLE_CONNS=2
# TENANCY_POOL_MAX_OPEN_CONNS=20
# TENANCY_SUBDOMAIN_RESERVED=www,api,admin,platform,static,assets
# PLATFORM_ADMIN_USERNAME=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=平台管理员

# 健康检查（无需改）：GET /health 存活；GET /ready 依赖探测
# READY_ALERT_WEBHOOK_URL=
# QUEUE_ALERT_WEBHOOK_URL=
# QUEUE_ALERT_BACKLOG_THRESHOLD=100
