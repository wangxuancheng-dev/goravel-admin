# 生产环境变量模板（复制为服务器上的 .env，勿提交真实密钥）
# 对照：website/docs/deploy/production.md、website/docs/guide/opensource.md
#
# cp .env.production.example .env
# go run . artisan key:generate
# 再填写 JWT_SECRET、数据库与 Redis

APP_NAME=Goravel
APP_ENV=production
APP_DEBUG=false
APP_URL=https://admin.example.com
APP_HOST=0.0.0.0
APP_PORT=3000
APP_KEY=
# APP_VERSION=1.0.0
# HTTPS terminator 后开启 HSTS（秒）
SECURITY_HSTS_MAX_AGE=31536000
JWT_SECRET=
JWT_TTL=600

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goravel
DB_USERNAME=
DB_PASSWORD=

# 生产必须用 Redis（多实例限流/锁/缓存一致）
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_CONCURRENT=2
QUEUE_TRIES=5
# API 节点（只 HTTP）：取消下一行注释
# APP_DISABLED_RUNNERS=queue-*
# Worker 节点：保持 APP_DISABLED_RUNNERS 为空，并确保 QUEUE_CONNECTION=redis
# 详见 website/docs/deploy/production.md §4.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# WebSocket cross-API push via Redis Pub/Sub (started automatically with ./main)
# WEBSOCKET_REDIS_BRIDGE=true
# WEBSOCKET_REDIS_CHANNEL=goravel:ws:notifications

SESSION_DRIVER=file
SESSION_LIFETIME=120

# 生产关闭调试面
SWAGGER_ENABLED=false
APP_ENABLE_DEV_TOOL=false
# PPROF_ENABLED=false

# 示例业务：不需要则关闭
MODULE_ORDERS_ENABLED=true
MODULE_SCHEDULE_DEMO_ENABLED=true
MODULE_PAYMENTS_ENABLED=false
# Production: explicit allowlist of RegisterPaymentGateway types (avoid empty/*).
# PAYMENT_GATEWAYS_ENABLED=wechat,alipay

# CORS: empty/* => any Origin (demo OK). Else allowlist + auto *.{TENANCY_BASE_DOMAIN}.
# Vanity + split API: prefer same-Host /api; do not list every merchant domain.
# CORS_ALLOWED_ORIGINS=https://admin.example.com
# CORS_ALLOWED_ORIGINS=
# DOMAINS_ADMIN=admin.example.com
# Multi-tenant + split Pages/API: Origin guard (no-op if TENANCY_DRIVER=off).
# ADMIN_ORIGIN_GUARD=true
# TENANCY_BASE_DOMAIN=example.com
# TENANCY_DOMAIN_TARGET=tenants.example.com  # static CNAME target for edge vanity; see tenancy.md

# 多租户一户一库（公网）：确认 DNS/运维后再开，见 website/docs/advanced/tenancy.md
# 默认池适合约 <50 活跃；千级务必收紧 OPEN + REGISTERED_MAX + 分 host，见文档「规模与推荐配置」
# TENANCY_DRIVER=database
# TENANCY_RESOLVER=subdomain
# TENANCY_ALLOW_HEADER_FALLBACK=false
# TENANCY_ALLOW_PLATFORM_DB_CREDENTIALS=false
# TENANCY_POOL_MAX_IDLE_CONNS=1
# TENANCY_POOL_MAX_OPEN_CONNS=2
# TENANCY_REGISTERED_IDLE_TTL=900
# TENANCY_REGISTERED_MAX=400
# TENANCY_SCOPE_AUTO_BATCH_AT=200
# TENANCY_SCOPE_AUTO_BATCH=100
# TENANCY_FLEX_SCHEDULE_TICK_LIMIT=2000
# TENANCY_FLEX_SCHEDULE_QUEUE=schedule
# TENANCY_MIGRATE_CONCURRENCY=2   # CLI migrate-all/seed-all only; same host 2-5; many tenants.host 20-50; max 100
# TENANCY_BACKUP_CONCURRENCY=2    # backup fleet parallel dumps (1..50); daily full uses this
# TENANT_BACKUP_SCHEDULE_MODE=full # full=every tenant/day; rotate=BATCH/day
# QUEUE_SCHEDULE_CONCURRENT=10    # collection; lower to 1-2 during migrate-all (competes for tenant DB IO)
# QUEUE_LONG_RUNNING_CONCURRENT=1  # UI tenant_ops; keep 1; do not stack with CLI migrate-all; restart Workers after change
# See website/docs/advanced/tenancy.md (UI batch + restart table)# TENANT_BACKUP_SCHEDULE_ENABLED=false
# TENANT_BACKUP_SCHEDULE_BATCH=100
# TENANCY_SUBDOMAIN_RESERVED=www,api,admin,platform,static,assets
# Worker 机勿设置 APP_DISABLED_RUNNERS=queue-*（需 queue-default / long-running / schedule）
# API 机：APP_DISABLED_RUNNERS=queue-*
# PLATFORM_ADMIN_USERNAME=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=Platform Admin

# 健康检查（无需改）：GET /health 存活；GET /ready 依赖探测
# READY_ALERT_WEBHOOK_URL=
# QUEUE_ALERT_WEBHOOK_URL=
# QUEUE_ALERT_BACKLOG_THRESHOLD=100
