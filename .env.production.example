# 生产环境变量模板（复制为服务器上的 .env，勿提交真实密钥）
# 对照说明：docs/OPENSOURCE.md §3「最小生产配置」
#
# cp .env.production.example .env
# go run . artisan key:generate
# 再填写 JWT_SECRET、数据库与 Redis

APP_NAME=Goravel
APP_ENV=production
APP_DEBUG=false
APP_URL=https://admin.example.com
APP_HOST=0.0.0.0
APP_PORT=3000
APP_KEY=
JWT_SECRET=
JWT_TTL=600

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goravel
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_CONCURRENT=2
QUEUE_TRIES=5

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

SESSION_DRIVER=file
SESSION_LIFETIME=120

# 生产建议关闭
SWAGGER_ENABLED=false
APP_ENABLE_DEV_TOOL=false

# 示例业务模块：不需要则关闭
MODULE_ORDERS_ENABLED=true
MODULE_PAYMENTS_ENABLED=false

# 多租户一户一库：生产确认运维方案后再开（见 docs/TENANT_RESERVED.md）
# TENANCY_DRIVER=off
# TENANCY_RESOLVER=header
# TENANCY_HEADER=X-Tenant-ID
# TENANCY_SUBDOMAIN_RESERVED=www,api,admin,platform,static,assets
# PLATFORM_ADMIN_USERNAME=admin
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=平台管理员

# CORS：按实际管理端域名填写
# CORS_ALLOWED_ORIGINS=https://admin.example.com
