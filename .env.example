# READY_ALERT_WEBHOOK_URL=
# 闃熷垪绉帇鍛婅锛堝畾鏃?queue:alert-backlog锛涚┖鍒欏洖閫€ READY_ALERT_WEBHOOK_URL锛涚殕绌?鍏抽棴锛?
# QUEUE_ALERT_WEBHOOK_URL=
# QUEUE_ALERT_BACKLOG_THRESHOLD=100
# 绉熸埛杩愮淮澶辫触鍛婅锛坢igrate/seed/backup 澶辫触锛涚┖鍒欏洖閫€ QUEUE_ALERT / READY_ALERT锛?
# TENANT_OPS_ALERT_WEBHOOK_URL=
# Tenant health inspect email (tenant:health-inspect; empty=off)
# TENANT_HEALTH_ALERT_MAIL=
# 绂佺敤鎸囧畾 Runner锛堥€楀彿鍒嗛殧锛屾敮鎸?glob锛?
# 闃熷垪 Runner 鍚嶄负 queue-default / queue-long-running / queue-search锛岀敤 queue-* 鍏抽棴锛堜笉鏄?queue:*锛?
# API 澶氭満鍙帴 HTTP 鏃讹細APP_DISABLED_RUNNERS=queue-*
# 澶氭満涓旀湰鏈轰笉璺戝畾鏃讹細APP_DISABLED_RUNNERS=queue-*,goravel:schedule
# 鏈厤缃?OTEL 鏃舵鏋朵細鑷姩绂佺敤 goravel:telemetry锛屽噺灏戞棩蹇楀櫔闊?
# APP_DISABLED_RUNNERS=queue-*
# 缁存姢妯″紡锛堝鏈洪儴缃插彲璁?APP_MAINTENANCE_DRIVER=cache 涓?APP_MAINTENANCE_STORE=redis锛?
# APP_MAINTENANCE_DRIVER=file
# 鍚敤缁存姢椤碉細go run . artisan down --render=maintenance
# 鐢熶骇鐜榛樿绂佺敤 artisan up/down锛涘鏈虹淮鎶ゆ椂鍙 APP_ALLOW_MAINTENANCE_COMMANDS=true
# APP_ALLOW_MAINTENANCE_COMMANDS=false
# Swagger 鏂囨。寮€鍏筹細鏈缃椂浠?local/development/test 榛樿寮€鍚紝production 榛樿鍏抽棴
# SWAGGER_ENABLED=false
