APP_NAME=Goravel
# APP_ENV=local,development,test,production
APP_ENV=local
APP_KEY=
# Optional build tag shown on GET /health
# APP_VERSION=1.0.0
APP_DEBUG=true
APP_URL=http://localhost
# Behind HTTPS only, e.g. 31536000 鈥?enables Strict-Transport-Security
# SECURITY_HSTS_MAX_AGE=0
# APP_HOST=127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=3000
# 鐢熶骇 / 寮€婧愰儴缃查厤缃鏄庤 website/docs/guide/opensource.md銆亀ebsite/docs/deploy/production.md锛?health /ready锛?
