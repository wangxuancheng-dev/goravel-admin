# 闃熷垪閰嶇疆
QUEUE_CONNECTION=redis
QUEUE_CONCURRENT=3
# long-running: platform UI tenant_ops (migrate/seed/backup). Keep 1 during CLI migrate-all.
# Change requires restart of Workers running queue-long-running (read at process start).
QUEUE_LONG_RUNNING_CONCURRENT=1
QUEUE_SEARCH_CONCURRENT=2
QUEUE_TRIES=5

