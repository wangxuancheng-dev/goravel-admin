APP_NAME=Goravel
# APP_ENV=local,development,test,production
APP_ENV=local
APP_KEY=
# Optional build tag shown on GET /health
# APP_VERSION=1.0.0
APP_DEBUG=true
APP_URL=http://localhost
# Behind HTTPS only, e.g. 31536000 — enables Strict-Transport-Security
# SECURITY_HSTS_MAX_AGE=0
# APP_HOST=127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=3000
# 生产 / 开源部署配置说明见 website/docs/guide/opensource.md、website/docs/deploy/production.md（/health /ready）
# /ready 失败时 POST JSON 告警（5 分钟防抖；空=关闭）
# READY_ALERT_WEBHOOK_URL=
# 队列积压告警（定时 queue:alert-backlog；空则回退 READY_ALERT_WEBHOOK_URL；皆空=关闭）
# QUEUE_ALERT_WEBHOOK_URL=
# QUEUE_ALERT_BACKLOG_THRESHOLD=100
# 租户运维失败告警（migrate/seed/backup 失败；空则回退 QUEUE_ALERT / READY_ALERT）
# TENANT_OPS_ALERT_WEBHOOK_URL=
# Tenant health inspect email (tenant:health-inspect; empty=off)
# TENANT_HEALTH_ALERT_MAIL=
# 禁用指定 Runner（逗号分隔，支持 glob）
# 队列 Runner 名为 queue-default / queue-long-running / queue-search，用 queue-* 关闭（不是 queue:*）
# API 多机只接 HTTP 时：APP_DISABLED_RUNNERS=queue-*
# 多机且本机不跑定时：APP_DISABLED_RUNNERS=queue-*,goravel:schedule
# 未配置 OTEL 时框架会自动禁用 goravel:telemetry，减少日志噪音
# APP_DISABLED_RUNNERS=queue-*
# 维护模式（多机部署可设 APP_MAINTENANCE_DRIVER=cache 与 APP_MAINTENANCE_STORE=redis）
# APP_MAINTENANCE_DRIVER=file
# 启用维护页：go run . artisan down --render=maintenance
# 生产环境默认禁用 artisan up/down；多机维护时可设 APP_ALLOW_MAINTENANCE_COMMANDS=true
# APP_ALLOW_MAINTENANCE_COMMANDS=false
# Swagger 文档开关：未设置时仅 local/development/test 默认开启，production 默认关闭
# SWAGGER_ENABLED=false
# 无时区偏移的时间字符串来源时区（用于响应时间转换）
APP_DISPLAY_SOURCE_TIMEZONE=UTC
# 响应时间字段白名单（逗号分隔；仅显式传时区时生效）
APP_RESPONSE_TIME_FIELDS=created_at,updated_at,deleted_at,pay_time

GRPC_HOST=
GRPC_PORT=


# JWT 配置
JWT_SECRET=
JWT_TTL=600             # Token 有效期（分钟），默认 600 分钟


# 日志配置
LOG_CHANNEL=stack
# 开发环境（显示所有日志，包括 debug）
LOG_LEVEL=debug
# 生产环境（只显示 info 及以上级别）
# LOG_LEVEL=info

# 缓存配置
CACHE_STORE=redis

# 队列配置
QUEUE_CONNECTION=redis
QUEUE_CONCURRENT=3
QUEUE_LONG_RUNNING_CONCURRENT=1
QUEUE_SEARCH_CONCURRENT=2
QUEUE_TRIES=5

# Redis Stream 配置
# QUEUE_REDIS_STREAM_GROUP=goravel
# QUEUE_REDIS_STREAM_BLOCK_MS=1000
# QUEUE_REDIS_STREAM_RETRY_AFTER=90
# QUEUE_REDIS_STREAM_CLAIM_COUNT=10
# QUEUE_REDIS_STREAM_DELETE_ON_ACK=false
# QUEUE_REDIS_STREAM_MAX_LEN=100000

# RabbitMQ 配置
# QUEUE_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
# QUEUE_RABBITMQ_QUEUE=default
# QUEUE_RABBITMQ_EXCHANGE=goravel.exchange
# QUEUE_RABBITMQ_EXCHANGE_TYPE=direct
# QUEUE_RABBITMQ_QUEUE_PREFIX=goravel-admin
# QUEUE_RABBITMQ_ROUTING_KEY=

# NSQ 配置
# QUEUE_NSQ_QUEUE=default
# QUEUE_NSQ_NSQD_TCP_ADDRESS=127.0.0.1:4150
# QUEUE_NSQ_CHANNEL=goravel
# QUEUE_NSQ_TIMEOUT_MS=1000
# QUEUE_NSQ_MAX_IN_FLIGHT=1

# Kafka 配置
# QUEUE_KAFKA_QUEUE=default
# QUEUE_KAFKA_BROKERS=127.0.0.1:9092
# QUEUE_KAFKA_GROUP_ID=goravel
# QUEUE_KAFKA_DIAL_TIMEOUT_MS=1000
# QUEUE_KAFKA_WRITE_TIMEOUT_MS=1000
# QUEUE_KAFKA_READ_TIMEOUT_MS=1000
# QUEUE_KAFKA_MAX_WAIT_MS=1000
# 导出任务执行锁 TTL（秒），用于防止同一 export_id 被并发重复执行
# QUEUE_EXPORT_EXECUTION_LOCK_TTL_SECONDS=7200

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goravel
DB_USERNAME=root
DB_PASSWORD=
# PostgreSQL 时使用（租户连接也可经 TENANCY_POSTGRES_SSLMODE 覆盖）
# DB_SSLMODE=disable
# DM 会话时区（可选）。不填则跟随 app.timezone
# DB_SESSION_TIMEZONE=UTC

# 多租户（一户一库 / PG 可 schema）。默认 off，不影响单库部署。
# 详见 website/docs/advanced/tenancy.md
# TENANCY_DRIVER=off
# TENANCY_RESOLVER=subdomain          # 公网推荐 subdomain；本地 SPA 可用 header
# TENANCY_HEADER=X-Tenant-ID
# TENANCY_ALLOW_HEADER_FALLBACK=      # 空：subdomain 默认禁止 Header 回落；header 模式默认可
# TENANCY_SUBDOMAIN_RESERVED=www,api,admin,platform,static,assets
# TENANCY_DATABASE_PREFIX=tenant_
# TENANCY_SCHEMA_PREFIX=tenant_
# TENANCY_PLATFORM_CONNECTION=   # 空=钉死为启动时的 database.default；勿填 tenant_*
# TENANCY_ALLOW_PLATFORM_DB_CREDENTIALS=false  # 公网默认 false；同机开发可 true
# TENANCY_POSTGRES_SSLMODE=      # 空则回落 DB_SSLMODE / disable；租户 PG 连接用
# TENANCY_BACKUP_KEEP=10         # tenant:backup 保留最近 N 份；0=不清理
# TENANT_BACKUP_SCHEDULE_ENABLED=false  # true: daily enqueue rotated page (not sync dump-all)
# TENANT_BACKUP_SCHEDULE_AT=20:00       # UTC DailyAt for scheduled backup
# TENANT_BACKUP_SCHEDULE_BATCH=100      # tenants enqueued per scheduled run
# TENANCY_DELETED_RETENTION_DAYS=30  # soft-deleted tenants auto hard-delete after N days (0=never); schedule tenant:cleanup-deleted
# Per-tenant pool; tighten when many merchants - see docs advanced/tenancy (scale section)
# TENANCY_POOL_MAX_IDLE_CONNS=2
# TENANCY_POOL_MAX_OPEN_CONNS=20
# TENANCY_POOL_CONN_MAX_IDLETIME=300
# TENANCY_POOL_CONN_MAX_LIFETIME=1800
# Process registry: idle TTL (seconds, default 900); max registered pools (0=unlimited). For 1k+ active set MAX=300-500 and OPEN=2-5.
# TENANCY_REGISTERED_IDLE_TTL=900
# TENANCY_REGISTERED_MAX=0
# Fleet sweeps: 0=unlimited below AUTO_BATCH_AT; above that auto page. Minute jobs rotate cursor.
# TENANCY_SCOPE_BATCH=0
# TENANCY_SCOPE_AUTO_BATCH_AT=200
# TENANCY_SCOPE_AUTO_BATCH=100
# TENANCY_FLEX_SCHEDULE_TICK_LIMIT=2000
# TENANCY_FLEX_SCHEDULE_QUEUE=schedule
# QUEUE_SCHEDULE_CONCURRENT=10
# Custom domains (vanity host -> tenant). Subdomain still works via TENANCY_BASE_DOMAIN.
# TENANCY_BASE_DOMAIN=example.com
# TENANCY_DOMAIN_TARGET=tenants.example.com
#   ^ one static ingress YOU resolve to edge/API; merchants CNAME their hosts here (ssl_mode=edge).
#   Not admin console host; not a comma-list of customer domains. See website/docs/advanced/tenancy.md
# TENANCY_DOMAIN_VERIFY_PREFIX=_goravel-tenant
# TENANCY_DOMAIN_CACHE_TTL=60
# 平台首启管理员（platform:install 可读；也可用 CLI 参数）
# PLATFORM_ADMIN_USERNAME=admin
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=平台管理员

SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# 文件存储（后台「配置管理 → 文件存储」选 file_disk；密钥等仍读 .env）
# FILESYSTEM_DISK=local
# S3 / Cloudflare R2（后台选 s3）
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_KEY_SECRET=
# AWS_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# 搜索引擎（可切换驱动；默认关闭；详见 website/docs/advanced/search.md）
# SEARCH_DRIVER=null                   # elasticsearch | meilisearch | null
# SEARCH_ENABLED=false
# SEARCH_SYNC_ORDERS=false
# SEARCH_ORDERS_INDEX=orders
# SEARCH_QUEUE=search
# SEARCH_SYNC_WORKER=auto              # auto | true | false
# SEARCH_OUTBOX_ENABLED=true
# 其他模块：业务侧 search.RegisterDefinition + search.indexes.<key>.*

# Elasticsearch 连接（仅 SEARCH_DRIVER=elasticsearch 时需要）
# ELASTICSEARCH_URLS=http://127.0.0.1:9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_CLOUD_ID=
# ELASTICSEARCH_INSECURE_SKIP_VERIFY=false
# ELASTICSEARCH_INDEX_PREFIX=
# ELASTICSEARCH_DEMO_INDEX=goravel_demo
# ELASTICSEARCH_ORDERS_ANALYZER=auto
# ELASTICSEARCH_ORDERS_SEARCH_ANALYZER=

# Meilisearch 连接（仅 SEARCH_DRIVER=meilisearch 时需要）
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_API_KEY=
# MEILISEARCH_INDEX_PREFIX=

# 分表配置
# SHARDING_TIME_SUFFIX_LAYOUT=200601
# SHARDING_MAX_TIME_RANGE_MONTHS=3
# SHARDING_ID_LOOKUP_SCAN_MONTHS=6
# SHARDING_USER_BALANCE_LOGS_SHARDS=4

# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=

# Notification channels (mail / webhook after create announcement)
# NOTIFICATION_MAIL_ENABLED=false
# NOTIFICATION_WEBHOOK_ENABLED=false
# NOTIFICATION_WEBHOOK_URL=
# Comma allowlists; empty = all types when channel enabled (e.g. announcement,login_anomaly)
# NOTIFICATION_MAIL_TYPES=
# NOTIFICATION_WEBHOOK_TYPES=

# Login security / password policy (optional overrides; defaults in config/login_security.go)
# LOGIN_SECURITY_MAX_ATTEMPTS=5
# LOGIN_SECURITY_LOCK_DURATION_MINUTES=15
# LOGIN_SECURITY_PASSWORD_MIN_LENGTH=8
# LOGIN_SECURITY_PASSWORD_REQUIRE_LETTER=true
# LOGIN_SECURITY_PASSWORD_REQUIRE_NUMBER=true
# LOGIN_SECURITY_PASSWORD_REQUIRE_SPECIAL=false
# LOGIN_SECURITY_ANOMALY_ALERT_ENABLED=true

# 开发者管理员id,多个
ADMIN_DEVELOPER_IDS=2

# 超管id
ADMIN_SUPER_ADMIN_ID=1

# Reserved usernames when creating admins (comma-separated, case-insensitive)
ADMIN_RESERVED_USERNAMES=admin,developer

# 隐藏服务监控菜单（开发者管理员除外）
ADMIN_MONITOR_HIDDEN=1

# 是否显示无权限的操作按钮
# false: 不显示（默认）- 用户没有权限时，按钮完全隐藏
# true: 显示但禁用 - 用户没有权限时，按钮显示但处于禁用状态
# ADMIN_SHOW_BUTTONS_WITHOUT_PERMISSION=false


# CORS
# CORS_ALLOWED_ORIGINS:
#   - empty / only blanks / *  => allow any Origin (demo-friendly; avoid as strict prod policy)
#   - comma list               => static allowlist + auto http(s)://*.{TENANCY_BASE_DOMAIN}
#   - wildcards OK             => e.g. https://*.example.com
# Vanity hosts on a split API: prefer same-Host /api proxy; demo may leave empty/*;
# do not add every merchant domain by hand. App middleware may also allow active tenant_domains.
# CORS_ALLOWED_ORIGINS=https://admin.com,http://localhost:3007,http://127.0.0.1:3007,http://localhost:3008,http://127.0.0.1:3008
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Timezone,Accept,Origin,Accept-Language,X-Tenant-ID
CORS_EXPOSED_HEADERS=Authorization,X-Trace-Id
CORS_MAX_AGE=3600
CORS_SUPPORTS_CREDENTIALS=true


# 后台接口域名白名单允许
# Single domain: DOMAINS_ADMIN=admin.example.com
# Multiple domains: DOMAINS_ADMIN=admin.example.com,*.admin.example.com
# Multiple domains with spaces: DOMAINS_ADMIN=admin.example.com, *.admin.example.com
# Disable domain restriction: DOMAINS_ADMIN= (empty or not set)
DOMAINS_ADMIN=

# Browser Origin guard for /api/admin (multi-tenant + split SPA/API only). Off by default.
# No-op when TENANCY_DRIVER=off. When true: allow Origin host if it matches DOMAINS_ADMIN,
# TENANCY_BASE_DOMAIN (apex + *.base), or an active tenant_domains vanity host.
# Empty Origin (curl) OK. Use with CORS empty/* for preflight.
# ADMIN_ORIGIN_GUARD=true
ADMIN_ORIGIN_GUARD=false


# 启用 pprof（生产环境需要显式设置）
# PPROF_ENABLED=true
# IP 白名单
# 支持单个 IP 和 CIDR 格式，多个 IP 用逗号分隔
# PPROF_ALLOWED_IPS=127.0.0.1,192.168.1.100,10.0.0.0/8
# 访问 token（可选，但强烈推荐）
# 如果设置，需要在请求头或查询参数中提供
# PPROF_TOKEN=your-secret-token-here

# 是否启用开发工具（生产环境需显式 true）
# - 表单演示：local/development/test 默认可见
# - 代码生成器：仅 local/development 默认可见（test 默认隐藏，需 APP_ENABLE_DEV_TOOL=true）
APP_ENABLE_DEV_TOOL=false

# 示例业务模块开关（纯 RBAC 后台可关闭订单/支付示例）
MODULE_ORDERS_ENABLED=true
# Demo / secondary-dev only (notify/query/refund unfinished). Keep false unless you need the UI.
MODULE_SCHEDULE_DEMO_ENABLED=true
MODULE_PAYMENTS_ENABLED=true
# Comma-separated gateway types to enable (must match RegisterPaymentGateway Type()).
# Empty / * / all = all registered drivers. Production: set an explicit allowlist (e.g. wechat,alipay).
# New channel checklist: add app/payment/gateways/<type>.go (SDK via go.mod OR hand-written) → append type here → optional PAYMENT_METHOD_TYPES + fields + i18n.
# Example: PAYMENT_GATEWAYS_ENABLED=wechat,alipay
# PAYMENT_GATEWAYS_ENABLED=

# 代码生成器前端目标：react | vue | react,vue | both（主发货为 React，建议 react,vue）
CODE_GENERATOR_FRONTEND=react,vue


# AI 配置（代码生成器 AI 辅助 + AI 实验室；未配置 API Key 时相关菜单/标签页自动隐藏）
AI_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI 实验室多模态（OpenAI 官方默认值，可不填）
# AI_MODEL_IMAGE=dall-e-3
# AI_MODEL_AUDIO=tts-1
# AI_MODEL_TRANSCRIPTION=whisper-1
# AI 实验室按管理员账号限流（演示站防滥用）
# AI_LAB_RATE_LIMIT_PER_MINUTE=1
# AI_LAB_RATE_LIMIT_PER_DAY=20
# AI_LAB_MAX_UPLOAD_MB=10
# 自定义 API 端点（可选，用于代理或兼容 OpenAI 的服务）
# AI_BASE_URL=https://api.openai.com/v1
# 兼容别名（与上方二选一即可）：OPENAI_API_KEY、OPENAI_BASE_URL


# OpenTelemetry（默认关闭；配置 exporter 后自动启用 Telemetry runner 与 HTTP 追踪）
# 导出器名称需与 config/telemetry.go exporters 键一致
# OTEL_TRACES_EXPORTER=otlptrace
# OTEL_METRICS_EXPORTER=otlpmetric
# OTEL_LOGS_EXPORTER=otlplog
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://127.0.0.1:4318
# OTEL_PROPAGATORS=tracecontext
# OTEL_TRACES_SAMPLER_TYPE=always_on
# OTEL_TRACES_SAMPLER_RATIO=0.05
# 本地调试可先用 console：OTEL_TRACES_EXPORTER=console


# HTTP Request Timeout (in seconds, default 300 seconds = 5 minutes)
HTTP_REQUEST_TIMEOUT=300

# 定时任务测试频率（Cron）
# 每5秒: */5 * * * * *
# 每10秒: */10 * * * * *
# 每分钟: */1 * * * *
# SCHEDULE_TEST_CRON=*/5 * * * * *
