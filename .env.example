APP_DISPLAY_SOURCE_TIMEZONE=UTC
# 鍝嶅簲鏃堕棿瀛楁鐧藉悕鍗曪紙閫楀彿鍒嗛殧锛涗粎鏄惧紡浼犳椂鍖烘椂鐢熸晥锛?
APP_RESPONSE_TIME_FIELDS=created_at,updated_at,deleted_at,pay_time

GRPC_HOST=
GRPC_PORT=


# JWT 閰嶇疆
JWT_SECRET=
JWT_TTL=600             # Token 鏈夋晥鏈燂紙鍒嗛挓锛夛紝榛樿 600 鍒嗛挓


# 鏃ュ織閰嶇疆
