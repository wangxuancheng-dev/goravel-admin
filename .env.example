# TENANT_BACKUP_SCHEDULE_ENABLED=false  # true: daily backup enqueue
# TENANT_BACKUP_SCHEDULE_AT=20:00       # UTC DailyAt for scheduled backup
# TENANT_BACKUP_SCHEDULE_MODE=full     # full=every ready tenant/day (fleet); rotate=BATCH/day
# TENANT_BACKUP_SCHEDULE_BATCH=100      # only when MODE=rotate
# TENANCY_BACKUP_CONCURRENCY=2         # parallel dumps inside backup fleet (1..50)