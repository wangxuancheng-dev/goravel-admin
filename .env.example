APP_NAME=Goravel
## EN: APP_ENV values: local, development, test, production
## ZH: APP_ENV 可选：local / development / test / production
APP_ENV=local
APP_KEY=
## EN: Optional build tag shown on GET /health
## ZH: 可选构建版本号，展示在 GET /health
# APP_VERSION=1.0.0
APP_DEBUG=true
APP_URL=http://localhost
## EN: Behind HTTPS only, e.g. 31536000 — enables Strict-Transport-Security
## ZH: 仅在 HTTPS 后使用，例如 31536000 — 启用 HSTS
# SECURITY_HSTS_MAX_AGE=0
## EN: Prefer APP_HOST=0.0.0.0 to listen on all interfaces; 127.0.0.1 for local only
## ZH: 推荐 APP_HOST=0.0.0.0 监听全部网卡；仅本机可用 127.0.0.1
# APP_HOST=127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=3000
## EN: Production / open-source setup: website/docs/guide/opensource.md and website/docs/deploy/production.md (health /ready)
## ZH: 生产 / 开源部署说明见 website/docs/guide/opensource.md、website/docs/deploy/production.md（含 health /ready）
## EN: POST JSON when /ready fails; 5-minute debounce; empty=off
## ZH: /ready 失败时 POST JSON 告警，5 分钟防抖；空=关闭
# READY_ALERT_WEBHOOK_URL=
## EN: Queue backlog alert (queue:alert-backlog); empty falls back to READY_ALERT_WEBHOOK_URL; both empty=off
## ZH: 队列积压告警（定时 queue:alert-backlog）；空则回退 READY_ALERT_WEBHOOK_URL；皆空=关闭
# QUEUE_ALERT_WEBHOOK_URL=
## EN: Backlog size threshold for queue alert
## ZH: 队列积压告警阈值
# QUEUE_ALERT_BACKLOG_THRESHOLD=100
## EN: Tenant ops failure alert (migrate/seed/backup); empty falls back to QUEUE_ALERT / READY_ALERT
## ZH: 租户运维失败告警（migrate/seed/backup）；空则回退 QUEUE_ALERT / READY_ALERT
# TENANT_OPS_ALERT_WEBHOOK_URL=
## EN: Tenant health inspect email (tenant:health-inspect); empty=off
## ZH: 租户健康巡检邮件（tenant:health-inspect）；空=关闭
# TENANT_HEALTH_ALERT_MAIL=
## EN: Disable runners (comma-separated, glob OK). Queue runners: queue-default / queue-long-running / queue-search — use queue-* (not queue:*)
## ZH: 禁用 Runner（逗号分隔，支持 glob）。队列 Runner：queue-default / queue-long-running / queue-search，用 queue-*（不是 queue:*）
## EN: API-only node: APP_DISABLED_RUNNERS=queue-* ; also skip schedule: APP_DISABLED_RUNNERS=queue-*,goravel:schedule
## ZH: API 多机只接 HTTP：APP_DISABLED_RUNNERS=queue-*；本机不跑定时再加 goravel:schedule
## EN: Without OTEL config the framework auto-disables goravel:telemetry to reduce log noise
## ZH: 未配置 OTEL 时框架会自动禁用 goravel:telemetry，减少日志噪音
# APP_DISABLED_RUNNERS=queue-*
## EN: Maintenance mode (multi-node: APP_MAINTENANCE_DRIVER=cache + APP_MAINTENANCE_STORE=redis)
## ZH: 维护模式（多机可设 APP_MAINTENANCE_DRIVER=cache 与 APP_MAINTENANCE_STORE=redis）
# APP_MAINTENANCE_DRIVER=file
## EN: Enable maintenance page: go run . artisan down --render=maintenance
## ZH: 启用维护页：go run . artisan down --render=maintenance
## EN: Production disables artisan up/down by default; set APP_ALLOW_MAINTENANCE_COMMANDS=true for multi-node maintenance
## ZH: 生产默认禁用 artisan up/down；多机维护可设 APP_ALLOW_MAINTENANCE_COMMANDS=true
# APP_ALLOW_MAINTENANCE_COMMANDS=false
## EN: Swagger docs: default on for local/development/test, off for production when unset
## ZH: Swagger：未设置时 local/development/test 默认开，production 默认关
# SWAGGER_ENABLED=false
## EN: Source timezone for naive datetime strings (response time conversion)
## ZH: 无时区偏移时间字符串的来源时区（用于响应时间转换）
APP_DISPLAY_SOURCE_TIMEZONE=UTC
## EN: Response time field allowlist (comma-separated; applies when timezone is explicit)
## ZH: 响应时间字段白名单（逗号分隔；仅显式传时区时生效）
APP_RESPONSE_TIME_FIELDS=created_at,updated_at,deleted_at,pay_time


## EN: JWT settings
## ZH: JWT 配置
JWT_SECRET=
## EN: Token TTL in minutes (default 600)
## ZH: Token 有效期（分钟），默认 600
JWT_TTL=600


## EN: Logging
## ZH: 日志配置
LOG_CHANNEL=stack
## EN: Dev: show all levels including debug
## ZH: 开发环境：显示所有日志（含 debug）
LOG_LEVEL=debug
## EN: Production: info and above
## ZH: 生产环境：只显示 info 及以上
# LOG_LEVEL=info

## EN: Cache
## ZH: 缓存配置
CACHE_STORE=redis

## EN: Queue
## ZH: 队列配置
QUEUE_CONNECTION=redis
QUEUE_CONCURRENT=3
## EN: long-running: platform UI tenant_ops (migrate/seed/backup). Keep 1 during CLI migrate-all. Restart queue-long-running workers after change.
## ZH: long-running：平台 UI 租户运维（migrate/seed/backup）。CLI migrate-all 期间保持 1。修改后需重启 queue-long-running Worker。
QUEUE_LONG_RUNNING_CONCURRENT=1
QUEUE_SEARCH_CONCURRENT=2
QUEUE_TRIES=5

## EN: Export job lock TTL (seconds); prevents concurrent runs for the same export_id
## ZH: 导出任务执行锁 TTL（秒）；防止同一 export_id 并发执行
# QUEUE_EXPORT_EXECUTION_LOCK_TTL_SECONDS=7200

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goravel
DB_USERNAME=root
DB_PASSWORD=
## EN: PostgreSQL SSL mode (tenant PG may override via TENANCY_POSTGRES_SSLMODE)
## ZH: PostgreSQL 用（租户连接也可经 TENANCY_POSTGRES_SSLMODE 覆盖）
# DB_SSLMODE=disable

## EN: Multi-tenancy (DB-per-tenant / PG schemas). Default off for single-DB deploys. See website/docs/advanced/tenancy.md
## ZH: 多租户（一户一库 / PG 多 schema）。默认 off，不影响单库。详见 website/docs/advanced/tenancy.md
# TENANCY_DRIVER=off
## EN: Public: subdomain; local SPA may use header
## ZH: 公网推荐 subdomain；本地 SPA 可用 header
# TENANCY_RESOLVER=subdomain
# TENANCY_HEADER=X-Tenant-ID
## EN: Empty: subdomain forbids header fallback; header mode defaults on
## ZH: 空：subdomain 默认禁止 Header 回落；header 模式默认开
# TENANCY_ALLOW_HEADER_FALLBACK=
# TENANCY_SUBDOMAIN_RESERVED=www,api,admin,platform,static,assets
# TENANCY_DATABASE_PREFIX=tenant_
# TENANCY_SCHEMA_PREFIX=tenant_
## EN: Empty pins to boot database.default; do not set tenant_*
## ZH: 空=钉死为启动时的 database.default；勿填 tenant_*
# TENANCY_PLATFORM_CONNECTION=
## EN: Public default false; same-host dev may true
## ZH: 公网默认 false；同机开发可 true
# TENANCY_ALLOW_PLATFORM_DB_CREDENTIALS=false
## EN: Empty falls back to DB_SSLMODE / disable
## ZH: 空则回落 DB_SSLMODE / disable；租户 PG 连接用
# TENANCY_POSTGRES_SSLMODE=
## EN: tenant:backup keep last N; 0=never prune
## ZH: tenant:backup 保留最近 N 份；0=不清理
# TENANCY_BACKUP_KEEP=10
## EN: true: daily backup enqueue
## ZH: true：每日备份入队
# TENANT_BACKUP_SCHEDULE_ENABLED=false
## EN: UTC DailyAt for scheduled backup
## ZH: 定时备份 UTC DailyAt
# TENANT_BACKUP_SCHEDULE_AT=20:00
## EN: full=every ready tenant/day; rotate=BATCH/day
## ZH: full=每天全部就绪租户；rotate=每天 BATCH 个
# TENANT_BACKUP_SCHEDULE_MODE=full
## EN: Only when MODE=rotate
## ZH: 仅 MODE=rotate 时有效
# TENANT_BACKUP_SCHEDULE_BATCH=100
## EN: Parallel dumps in backup fleet (1..50)
## ZH: 备份车队并行 dump 数（1..50）
# TENANCY_BACKUP_CONCURRENCY=2
## EN: Soft-deleted tenants hard-delete after N days (0=never); schedule tenant:cleanup-deleted
## ZH: 软删租户 N 天后硬删（0=永不）；调度 tenant:cleanup-deleted
# TENANCY_DELETED_RETENTION_DAYS=30
## EN: Per-tenant pool; tighten for many merchants — see docs advanced/tenancy (scale)
## ZH: 每租户连接池；商户多时收紧 — 见文档 advanced/tenancy 规模章节
# TENANCY_POOL_MAX_IDLE_CONNS=2
# TENANCY_POOL_MAX_OPEN_CONNS=20
# TENANCY_POOL_CONN_MAX_IDLETIME=300
# TENANCY_POOL_CONN_MAX_LIFETIME=1800
## EN: Process registry: idle TTL seconds (default 900); max pools (0=unlimited). For 1k+ active set MAX=300-500 and OPEN=2-5.
## ZH: 进程内注册表：空闲 TTL 秒（默认 900）；最大池数（0=不限）。千级活跃建议 MAX=300-500 且 OPEN=2-5。
# TENANCY_REGISTERED_IDLE_TTL=900
# TENANCY_REGISTERED_MAX=0
## EN: Fleet sweeps: 0=unlimited below AUTO_BATCH_AT; above that auto page. Minute jobs rotate cursor.
## ZH: 车队扫描：低于 AUTO_BATCH_AT 时 0=不限；超过则自动分页。分钟任务轮转游标。
# TENANCY_SCOPE_BATCH=0
# TENANCY_SCOPE_AUTO_BATCH_AT=200
# TENANCY_SCOPE_AUTO_BATCH=100
# TENANCY_FLEX_SCHEDULE_TICK_LIMIT=2000
# TENANCY_FLEX_SCHEDULE_QUEUE=schedule
## EN: Fleet CLI + platform UI batch migrate/seed/rollback (tenant_ops_fleet). NOT QUEUE_LONG_RUNNING_CONCURRENT. Wall ~ ceil(tenants/N)*per-tenant. Same host 2-5; many tenants.host 20-50.
## ZH: 车队 CLI + 平台 UI 批量 migrate/seed/rollback（tenant_ops_fleet）。不是 QUEUE_LONG_RUNNING_CONCURRENT。耗时约 ceil(租户数/N)*单户。同机 2-5；多 tenants.host 20-50。
## EN: During migrate-all: lower QUEUE_SCHEDULE_CONCURRENT (or pause tick); keep QUEUE_LONG_RUNNING_CONCURRENT=1; avoid UI batch migrate. See tenancy.md concurrency knobs.
## ZH: migrate-all 期间：降低 QUEUE_SCHEDULE_CONCURRENT（或暂停 tick）；保持 QUEUE_LONG_RUNNING_CONCURRENT=1；避免 UI 批量迁移。见 tenancy.md 并发旋钮。
# TENANCY_MIGRATE_CONCURRENCY=2
# QUEUE_SCHEDULE_CONCURRENT=10
## EN: Custom domains (vanity host -> tenant). Subdomain still works via TENANCY_BASE_DOMAIN.
## ZH: 自定义域名（vanity host -> 租户）。子域仍走 TENANCY_BASE_DOMAIN。
# TENANCY_BASE_DOMAIN=example.com
## EN: Static ingress YOU resolve to edge/API; merchants CNAME here (ssl_mode=edge). Not admin host; not a comma-list. See tenancy.md
## ZH: 由你解析到边缘/API 的静态入口；商户 CNAME 到此（ssl_mode=edge）。不是后台域名，不是客户域列表。见 tenancy.md
# TENANCY_DOMAIN_TARGET=tenants.example.com
# TENANCY_DOMAIN_VERIFY_PREFIX=_goravel-tenant
# TENANCY_DOMAIN_CACHE_TTL=60
## EN: Platform bootstrap admin (platform:install; or CLI flags)
## ZH: 平台首启管理员（platform:install 可读；也可用 CLI 参数）
# PLATFORM_ADMIN_USERNAME=admin
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_NAME=Platform Admin


REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=
## EN: Plain TCP by default. For TLS (rediss / AWS ElastiCache in-transit): REDIS_TLS=true
## ZH: 默认明文 TCP。TLS（rediss / AWS ElastiCache 传输加密）设 REDIS_TLS=true
# REDIS_TLS=true
## EN: Empty = use REDIS_HOST (SNI / cert verify)
## ZH: 空=使用 REDIS_HOST（SNI / 证书校验）
# REDIS_TLS_SERVER_NAME=
## EN: Debug only; never in production
## ZH: 仅调试；生产勿开
# REDIS_TLS_INSECURE_SKIP_VERIFY=false
## EN: true for Redis Cluster / some serverless endpoints
## ZH: Redis Cluster / 部分 Serverless 端点设 true
# REDIS_CLUSTER=false

## EN: WebSocket multi-API fan-out (auto on Boot; same ./main, no extra command)
## ZH: WebSocket 多 API 节点扇出（Boot 自动；同一 ./main，无需额外命令）
# WEBSOCKET_REDIS_BRIDGE=true
# WEBSOCKET_REDIS_CONNECTION=default
# WEBSOCKET_REDIS_CHANNEL=goravel:ws:notifications
# WEBSOCKET_REDIS_PRESENCE_KEY=goravel:ws:presence

## EN: File storage (Admin Config -> File disk writes file_disk; secrets still from .env)
## ZH: 文件存储（后台「配置管理 → 文件存储」写 file_disk；密钥等仍读 .env）
# FILESYSTEM_DISK=local
## EN: S3 / Cloudflare R2 (choose s3 in admin)
## ZH: S3 / Cloudflare R2（后台选 s3）
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_KEY_SECRET=
# AWS_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

## EN: Search engine (switchable; default off). See website/docs/advanced/search.md
## ZH: 搜索引擎（可切换驱动；默认关闭）。详见 website/docs/advanced/search.md
## EN: elasticsearch | meilisearch | null
## ZH: elasticsearch | meilisearch | null
# SEARCH_DRIVER=null
# SEARCH_ENABLED=false
# SEARCH_SYNC_ORDERS=false
# SEARCH_ORDERS_INDEX=orders
# SEARCH_QUEUE=search
## EN: auto | true | false
## ZH: auto | true | false
# SEARCH_SYNC_WORKER=auto
# SEARCH_OUTBOX_ENABLED=true
## EN: Other modules: search.RegisterDefinition + search.indexes.<key>.*
## ZH: 其他模块：业务侧 search.RegisterDefinition + search.indexes.<key>.*

## EN: Elasticsearch (only when SEARCH_DRIVER=elasticsearch)
## ZH: Elasticsearch 连接（仅 SEARCH_DRIVER=elasticsearch）
# ELASTICSEARCH_URLS=http://127.0.0.1:9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_CLOUD_ID=
# ELASTICSEARCH_INSECURE_SKIP_VERIFY=false
# ELASTICSEARCH_INDEX_PREFIX=
# ELASTICSEARCH_DEMO_INDEX=goravel_demo
# ELASTICSEARCH_ORDERS_ANALYZER=auto
# ELASTICSEARCH_ORDERS_SEARCH_ANALYZER=

## EN: Meilisearch (only when SEARCH_DRIVER=meilisearch)
## ZH: Meilisearch 连接（仅 SEARCH_DRIVER=meilisearch）
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_API_KEY=
# MEILISEARCH_INDEX_PREFIX=

## EN: Sharding
## ZH: 分表配置
# SHARDING_TIME_SUFFIX_LAYOUT=200601
# SHARDING_MAX_TIME_RANGE_MONTHS=3
# SHARDING_ID_LOOKUP_SCAN_MONTHS=6
# SHARDING_USER_BALANCE_LOGS_SHARDS=4

# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=

## EN: Notification channels (mail / webhook after create announcement)
## ZH: 通知渠道（创建公告后的邮件 / Webhook）
# NOTIFICATION_MAIL_ENABLED=false
# NOTIFICATION_WEBHOOK_ENABLED=false
# NOTIFICATION_WEBHOOK_URL=
## EN: Comma allowlists; empty = all types when channel enabled (e.g. announcement,login_anomaly)
## ZH: 逗号白名单；空=渠道开启时全部类型（如 announcement,login_anomaly）
# NOTIFICATION_MAIL_TYPES=
# NOTIFICATION_WEBHOOK_TYPES=

## EN: Login security / password policy (optional; defaults in config/login_security.go)
## ZH: 登录安全 / 密码策略（可选覆盖；默认见 config/login_security.go）
# LOGIN_SECURITY_MAX_ATTEMPTS=5
# LOGIN_SECURITY_LOCK_DURATION_MINUTES=15
# LOGIN_SECURITY_PASSWORD_MIN_LENGTH=8
# LOGIN_SECURITY_PASSWORD_REQUIRE_LETTER=true
# LOGIN_SECURITY_PASSWORD_REQUIRE_NUMBER=true
# LOGIN_SECURITY_PASSWORD_REQUIRE_SPECIAL=false
# LOGIN_SECURITY_ANOMALY_ALERT_ENABLED=true

## EN: Developer admin IDs (comma-separated)
## ZH: 开发者管理员 id，多个逗号分隔
ADMIN_DEVELOPER_IDS=2

## EN: Super-admin id
## ZH: 超管 id
ADMIN_SUPER_ADMIN_ID=1

## EN: Business field desensitization (list + export). Detail/show stays plain for edit forms.
## ZH: 业务字段脱敏（列表 + 导出）。详情/编辑表单仍为明文。
## EN: Process default; override per tenant/site in Admin -> Config -> Desensitize (configs.desensitize.enabled). Multi-tenant tip: false here, enable only where needed.
## ZH: 进程默认；可在后台「配置 → 脱敏」按租户覆盖。多租户建议此处 false，只对需要的租户开启。
# DESENSITIZE_ENABLED=true
# DESENSITIZE_BYPASS_ROLE_SLUGS=super-admin

## EN: Reserved usernames when creating admins (comma-separated, case-insensitive)
## ZH: 创建管理员时的保留用户名（逗号分隔，不区分大小写）
ADMIN_RESERVED_USERNAMES=admin,developer

## EN: Hide service monitor menu (except developer admins)
## ZH: 隐藏服务监控菜单（开发者管理员除外）
ADMIN_MONITOR_HIDDEN=1

## EN: Show action buttons without permission: false=hide (default); true=show disabled
## ZH: 无权限时是否显示操作按钮：false=不显示（默认）；true=显示但禁用
# ADMIN_SHOW_BUTTONS_WITHOUT_PERMISSION=false


## EN: CORS
## ZH: CORS 跨域
## EN: CORS_ALLOWED_ORIGINS: empty/blanks/* => any Origin (demo-friendly; avoid as strict prod). Comma list => static allowlist + auto http(s)://*.{TENANCY_BASE_DOMAIN}. Wildcards OK e.g. https://*.example.com
## ZH: CORS_ALLOWED_ORIGINS：空/空白/* => 任意 Origin（演示友好，严格生产勿用）。逗号列表 => 静态白名单 + 自动 http(s)://*.{TENANCY_BASE_DOMAIN}。可用通配如 https://*.example.com
## EN: Vanity + split API: prefer same-Host /api proxy; demo may leave empty/*; do not add every merchant domain by hand. Middleware may allow active tenant_domains.
## ZH: 独立域名 + 前后端分离：优先同 Host /api 反代；演示可空/*；勿手写每个商户域。中间件也可能放行已激活 tenant_domains。
# CORS_ALLOWED_ORIGINS=https://admin.com,http://localhost:3007,http://127.0.0.1:3007,http://localhost:3008,http://127.0.0.1:3008
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Timezone,Accept,Origin,Accept-Language,X-Tenant-ID
CORS_EXPOSED_HEADERS=Authorization,X-Trace-Id
CORS_MAX_AGE=3600
CORS_SUPPORTS_CREDENTIALS=true


## EN: Admin API Host allowlist
## ZH: 后台接口域名白名单
## EN: Single: DOMAINS_ADMIN=admin.example.com ; multi: admin.example.com,*.admin.example.com ; empty=disable restriction
## ZH: 单域名 / 多域名（可含空格）/ 空=关闭域名限制
DOMAINS_ADMIN=

## EN: Browser Origin guard for /api/admin (multi-tenant + split SPA/API). Off by default. No-op when TENANCY_DRIVER=off.
## ZH: 浏览器 Origin 校验（多租户 + 前后端分离）。默认关。TENANCY_DRIVER=off 时无效。
## EN: When true: allow Origin if DOMAINS_ADMIN, TENANCY_BASE_DOMAIN (apex+*.base), or active tenant_domains. Empty Origin (curl) OK. Use with CORS empty/* for preflight.
## ZH: 为 true 时：Origin 匹配 DOMAINS_ADMIN、TENANCY_BASE_DOMAIN（根域+*.base）或已激活独立域名则放行。空 Origin（curl）可通过。可与 CORS 空/* 配合预检。
# ADMIN_ORIGIN_GUARD=true
ADMIN_ORIGIN_GUARD=false


## EN: Enable pprof (production must set explicitly)
## ZH: 启用 pprof（生产需显式设置）
# PPROF_ENABLED=true
## EN: IP allowlist: single IP or CIDR, comma-separated
## ZH: IP 白名单：单个 IP 或 CIDR，逗号分隔
# PPROF_ALLOWED_IPS=127.0.0.1,192.168.1.100,10.0.0.0/8
## EN: Access token via header/query. At least one of PPROF_TOKEN or PPROF_ALLOWED_IPS is required or routes stay unregistered.
## ZH: 访问 token（请求头或查询参数）。PPROF_TOKEN 与 PPROF_ALLOWED_IPS 至少配一项，否则不会注册路由。
# PPROF_TOKEN=your-secret-token-here

## EN: Dev tools: form demo visible in local/development/test; code generator only local/development by default (test needs APP_ENABLE_DEV_TOOL=true)
## ZH: 开发工具：表单演示在 local/development/test 可见；代码生成器默认仅 local/development（test 需 APP_ENABLE_DEV_TOOL=true）
APP_ENABLE_DEV_TOOL=false

## EN: Demo business modules (pure RBAC admin may disable orders/payments demos)
## ZH: 示例业务模块开关（纯 RBAC 后台可关闭订单/支付示例）
MODULE_ORDERS_ENABLED=true
## EN: Demo / secondary-dev only (notify/query/refund unfinished). Keep false unless you need the UI.
## ZH: 演示/次要开发用（通知/查询/退款未完成）。不需要 UI 请保持 false。
MODULE_SCHEDULE_DEMO_ENABLED=true
MODULE_PAYMENTS_ENABLED=true
## EN: Comma-separated payment gateway types (RegisterPaymentGateway Type()). Empty/*/all = all drivers. Production: explicit allowlist e.g. wechat,alipay.
## ZH: 逗号分隔支付网关类型（须匹配 RegisterPaymentGateway Type()）。空/*/all=全部。生产请显式白名单如 wechat,alipay。
## EN: New channel: app/payment/gateways/<type>.go -> append type here -> optional PAYMENT_METHOD_TYPES + fields + i18n.
## ZH: 新渠道清单：加 gateway 实现 -> 追加类型到此 -> 可选支付方式配置与 i18n。
# Example: PAYMENT_GATEWAYS_ENABLED=wechat,alipay
# PAYMENT_GATEWAYS_ENABLED=

## EN: Code generator frontends: react | vue | react,vue | both (primary ship is React; suggest react,vue)
## ZH: 代码生成器前端目标：react | vue | react,vue | both（主发货 React，建议 react,vue）
CODE_GENERATOR_FRONTEND=react,vue
## EN: Extra tables/prefixes hidden in code-generator picker (comma-separated). Built-ins: app/codegenerator/reserved.go
## ZH: 代码生成器表选择额外隐藏的表名/前缀（逗号分隔）。内置名单：app/codegenerator/reserved.go
# CODE_GENERATOR_EXTRA_RESERVED_TABLES=
# CODE_GENERATOR_EXTRA_RESERVED_TABLE_PREFIXES=


## EN: AI (codegen assist + AI Lab). Menus/tabs hide when API key unset.
## ZH: AI 配置（代码生成器 AI 辅助 + AI 实验室；未配置 API Key 时相关菜单/标签页自动隐藏）
AI_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
## EN: AI Lab multimodal models (OpenAI defaults; optional)
## ZH: AI 实验室多模态模型（OpenAI 官方默认，可不填）
# AI_MODEL_IMAGE=dall-e-3
# AI_MODEL_AUDIO=tts-1
# AI_MODEL_TRANSCRIPTION=whisper-1
## EN: AI Lab per-admin rate limits (demo abuse protection)
## ZH: AI 实验室按管理员限流（演示站防滥用）
# AI_LAB_RATE_LIMIT_PER_MINUTE=1
# AI_LAB_RATE_LIMIT_PER_DAY=20
# AI_LAB_MAX_UPLOAD_MB=10
## EN: Custom API endpoint (proxy / OpenAI-compatible)
## ZH: 自定义 API 端点（代理或兼容 OpenAI 的服务）
# AI_BASE_URL=https://api.openai.com/v1
## EN: Aliases (either set): OPENAI_API_KEY, OPENAI_BASE_URL
## ZH: 兼容别名（与上方二选一）：OPENAI_API_KEY、OPENAI_BASE_URL


## EN: OpenTelemetry (off by default; configuring exporter enables Telemetry runner + HTTP tracing)
## ZH: OpenTelemetry（默认关闭；配置 exporter 后自动启用 Telemetry runner 与 HTTP 追踪）
## EN: Exporter names must match keys in config/telemetry.go
## ZH: 导出器名称需与 config/telemetry.go exporters 键一致
# OTEL_TRACES_EXPORTER=otlptrace
# OTEL_METRICS_EXPORTER=otlpmetric
# OTEL_LOGS_EXPORTER=otlplog
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://127.0.0.1:4318
# OTEL_PROPAGATORS=tracecontext
# OTEL_TRACES_SAMPLER_TYPE=always_on
# OTEL_TRACES_SAMPLER_RATIO=0.05
## EN: Local debug: OTEL_TRACES_EXPORTER=console
## ZH: 本地调试可先用 console：OTEL_TRACES_EXPORTER=console


## EN: HTTP request timeout in seconds (default 300 = 5 minutes)
## ZH: HTTP 请求超时（秒，默认 300 = 5 分钟）
HTTP_REQUEST_TIMEOUT=300

# ---------------------------------------------------------------------------
## EN: Prometheus metrics scrape (GET /metrics)
## ZH: Prometheus 指标抓取（GET /metrics）
# ---------------------------------------------------------------------------
# METRICS_ENABLED=false
# METRICS_TOKEN=

# ---------------------------------------------------------------------------
## EN: OIDC / Enterprise SSO (admin login)
## ZH: OIDC / 企业 SSO（后台登录）
# ---------------------------------------------------------------------------
# OIDC_ENABLED=false
# OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://api.example.com/api/admin/auth/oidc/callback
# OIDC_FRONTEND_REDIRECT=https://admin.example.com/login/oidc-callback
# OIDC_SCOPES=openid profile email
# OIDC_BUTTON_LABEL=Enterprise SSO
# OIDC_AUTO_PROVISION=false

# ---------------------------------------------------------------------------
## EN: Audit log retention (days) for scheduled operation/login log archives
## ZH: 审计日志保留天数（定时归档操作/登录日志）
## EN: Optional SIEM webhook: JSON POST for login + operation audit events
## ZH: 可选 SIEM Webhook：登录与操作审计事件 JSON POST
# ---------------------------------------------------------------------------
# AUDIT_LOG_RETENTION_DAYS=30
# AUDIT_WEBHOOK_URL=
