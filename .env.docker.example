# Copy to .env before `docker compose up`:
#   cp .env.docker.example .env
#
# Values below are for LOCAL DOCKER ONLY. Do not use in production.

APP_NAME=Goravel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_HOST=0.0.0.0
APP_PORT=3000
# Fixed demo keys for local docker; regenerate for any real deploy:
#   go run . artisan key:generate
# Goravel requires APP_KEY to be exactly 32 characters (no base64: prefix).
APP_KEY=docker-local-demo-key-32bytes!!!
JWT_SECRET=docker-local-jwt-secret-change-me
JWT_TTL=600

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=goravel
DB_USERNAME=goravel
DB_PASSWORD=goravel

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=sync

# Allow Vue + React local Vite origins
# CORS_ALLOWED_ORIGINS=http://localhost:3007,http://localhost:3008,http://127.0.0.1:3007,http://127.0.0.1:3008
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin,X-CSRF-TOKEN,X-Timezone,Accept-Language,X-Tenant-ID

# Optional modules (example payments are admin CRUD only — see website/docs/guide/opensource.md)
MODULE_ORDERS_ENABLED=true
MODULE_PAYMENTS_ENABLED=true

FILESYSTEM_DISK=local
EXPORT_DISK=public

RUN_SEED=true
SKIP_MIGRATE=false
